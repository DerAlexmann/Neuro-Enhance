# Zeilenenden im Repository einheitlich, im Arbeitsverzeichnis nach Betriebssystem
* text=auto

*.py   text diff=python
*.pyw  text diff=python
*.md   text
*.toml text
*.cmd  text eol=crlf
# Lizenztexte werden byte-genau mit Modellen verteilt und per SHA-256 geprueft
LICENSES/*.txt text eol=lf

*.png binary
*.ico binary
*.exe binary
*.onnx binary
*.engine binary
